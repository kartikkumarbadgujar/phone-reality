# Optional: relocate persistent SQLite database
# BUDGETBENCH_DB=C:/path/to/budgetbench.sqlite3

# Required on public/hosted deployments. Use a long random value and set it
# through Streamlit Community Cloud's Secrets UI; do not commit the real value.
# BUDGETBENCH_ACCESS_KEY=replace-with-a-long-random-secret

# Optional: configure future Neo4j integration (not yet active in this build)
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
